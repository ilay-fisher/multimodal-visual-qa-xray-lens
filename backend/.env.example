# Copy to backend/.env and adjust. Never commit the real .env file.

# VLM backend: demo (free, no keys) | local (oMLX / Ollama) | cloud (Anthropic / OpenAI)
VLM_MODE=demo

# Local OpenAI-compatible server (oMLX default port 8000; Ollama: http://localhost:11434/v1).
# Inside Docker Compose this defaults to http://host.docker.internal:8000/v1.
LOCAL_VLM_BASE_URL=http://localhost:8000/v1
LOCAL_VLM_MODEL=Qwen2.5-VL-7B-Instruct-4bit
# oMLX requires a key; put the real value only in your private .env.
LOCAL_VLM_API_KEY=local

# Cloud provider: anthropic | openai
CLOUD_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Timeout for one VLM call, in seconds
VLM_TIMEOUT_S=45

# Cost guards (cloud mode)
CLOUD_DAILY_REQUEST_CAP=200
RATE_LIMIT_PER_MINUTE=30

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Logging: level DEBUG | INFO | WARNING | ERROR, format json | console
LOG_LEVEL=INFO
LOG_FORMAT=json

# Directory with sample image pairs (defaults to backend/samples next to the package)
# SAMPLES_DIR=
